# comma-separated if the site has more than one address; the first is used for payment redirects
# production (Cloud Run + domain): FRONTEND_URL=https://rr.kyzed.com
FRONTEND_URL=http://localhost:5173,http://localhost:5174
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Postgres connection URL (for example from neon.tech); leave empty to use the SQLite file below
DATABASE_URL=
# SQLite file; on a server without DATABASE_URL, point this at a persistent volume, e.g. /data/app.db
DB_PATH=

# shown on the Terms page and in the footer
SUPPORT_EMAIL=

# "Continue with Google" through Firebase Authentication
# (Firebase console > Project settings > General > Your apps > Web app config)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# comma-separated emails that can open the admin test designer
ADMIN_EMAILS=

# AI test generator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# only for OpenAI-compatible providers (not OpenAI itself),
# e.g. DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1 and OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=
