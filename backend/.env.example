# comma-separated if the site has more than one address; the first is used for payment redirects
FRONTEND_URL=http://localhost:5173,http://localhost:5174
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# on the server, point this at a persistent volume, e.g. /data/app.db
DB_PATH=

# "Continue with Google" through Firebase Authentication
# (Firebase console > Project settings > General > Your apps > Web app config)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# comma-separated emails that can open the admin test designer
ADMIN_EMAILS=

# AI test generator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
