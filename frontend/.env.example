# local API (leave empty in production — same host serves /api)
VITE_API_URL=http://127.0.0.1:8000

# public site address (used for Open Graph, canonical, sitemap)
VITE_SITE_URL=https://rr.kyzed.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXX). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token. Leave empty until you verify.
VITE_GSC_VERIFICATION=
